# --- Required in production -------------------------------------------------------------
# Master secret for HMAC (CNIC identity hashing, token signatures, org API keys).
# Min 32 chars. Keep it in an env secret / secrets manager, NEVER in code or the database.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BASITNA_HMAC_SECRET=

# PostgreSQL connection string. If empty, an in-memory demo store is used (data lost on restart).
DATABASE_URL=
# Set to true for managed Postgres that requires TLS
PGSSL=false

# --- Optional ------------------------------------------------------------------------------
# Protects /api/tokens/list, /api/audit-logs, /api/database/dump and /api/reset (send as x-admin-key).
# In production these endpoints are disabled unless this is set.
ADMIN_API_KEY=

# Demo mode (default on in development): sandbox UI auto-fills each organization's API key.
# Always off when NODE_ENV=production.
DEMO_MODE=true

# AI privacy analysis (falls back to the local heuristic engine when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=3000
NODE_ENV=development
